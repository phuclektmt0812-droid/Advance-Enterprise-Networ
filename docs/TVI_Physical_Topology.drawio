        <mxCell id="hcmc" value="HCMC HQ — MDF / NETWORK ROOM&#xa;R1 + R2: redundant WAN edge / L3 gateways&#xa;SW1 + SW2: collapsed distribution/access&#xa;2 x LACP inter-switch links; RSTP root primary/secondary&#xa;&#xa;SERVER RACK&#xa;HQ-DHCP-DNS: DHCP / DNS / NTP / Syslog / HTTP&#xa;AUTOMATION: Netmiko control host&#xa;&#xa;Access: Executive / Engineering / Guest / IoT / Voice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F0FF;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="470" height="390" as="geometry"/></mxCell>
